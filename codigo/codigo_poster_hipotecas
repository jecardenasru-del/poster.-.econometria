# BASE DE DATOS REFERENCIADA: 
# Freddie Mac, Promedio de hipotecas a tipo fijo a 30 años en Estados Unidos [MORTGAGE30US],
# recuperado de FRED, Banco de la Reserva Federal de St. Louis; https://fred.stlouisfed.org/series/MORTGAGE30US, 22 de mayo de 2026.

#%% Librerias
import numpy as np
import pandas as pd
from pathlib import Path
import matplotlib.pyplot as plt
from statsmodels.tsa.arima.model import ARIMA
from statsmodels.graphics.tsaplots import plot_acf, plot_pacf
import warnings
import pmdarima as pm # para halar el mejor modelo de ARIMA
from statsmodels.stats.diagnostic import acorr_ljungbox # para la prueba de autocorrelacion de los residuos
warnings.filterwarnings('ignore')
from statsmodels.tsa.stattools import adfuller # para el test de raiz unitaria
from statsmodels.stats.diagnostic import het_arch
from statsmodels.stats.stattools import jarque_bera
from scipy.stats import norm
import scipy.stats as stats
from statsmodels.tsa.statespace.sarimax import SARIMAX

#%%  BASE DE DATOS 
CARPETA_ACTUAL = Path('.').resolve()

# parent sube un nivel (sale de 'codigo') y luego entra a 'bases_de_datos'
ruta_hipotecas = CARPETA_ACTUAL.parent / "bases_de_datos" / "Hipotecas_MORTGAGE30US.csv"

#Carga la base de datos
df_hipotecas = pd.read_csv(ruta_hipotecas, parse_dates=['observation_date'], index_col='observation_date')
#%% mirar la base de datos
# Renombro las columnas por que tiene un nombre muy feo y tedioso
df_hipotecas = df_hipotecas.rename(columns={'MORTGAGE30US': 'Tasa_hipotecaria'})
print(df_hipotecas.info())
print(df_hipotecas.describe())

#%% Grafica de la serie de tiempo 
plt.figure(figsize=(12, 6))
plt.plot(df_hipotecas.index, df_hipotecas['Tasa_hipotecaria'], color='darkblue', linewidth=2)
plt.title('Promedio de Tasa Hipotecaria Fija a 30 Años en EE.UU. (Niveles)', fontsize=14, fontweight='bold')
plt.xlabel('Tiempo (Años)')
plt.ylabel('y_t (Porcentaje %)')
plt.grid(True, linestyle='--')
plt.show()

# Nota : Se puede apreciar que no tiene ni media ni varianza constante, por lo que no es estacionaria.
# Por ello voy a aplicar primer logarritmo y luego diferencia para intentar hacerla estacionaria :D
#  
#%% Grafico con la transformacion de logaritmo
df_hipotecas['log_hipotecas'] = np.log(df_hipotecas['Tasa_hipotecaria'])
# Se anade un columna de log de los datos en la base de datos
plt.figure(figsize=(12, 6))
plt.plot(df_hipotecas.index, df_hipotecas['log_hipotecas'], color='red', linewidth=2)
plt.title('Logaritmo Natural del Promedio de Tasa Hipotecaria Fija a 30 Años', fontsize=14, fontweight='bold')
plt.xlabel('Tiempo (Años)')
plt.ylabel('log(y_t)')
plt.grid(True, linestyle='--')
plt.show()

# %% Comparativa entre la serie original y la transformada en logaritmo

plt.figure(figsize=(12, 6))

# 1. Grafica serie original (Rojo)
plt.plot(df_hipotecas.index, df_hipotecas['Tasa_hipotecaria'], color='red', linewidth=2, label='Tasa Original (%)')
plt.ylabel('Tasa Original (%)', color='red')
plt.grid(True, linestyle='--')

# 2. Activar el segundo eje Y compartiendo el mismo eje X
plt.twinx()

# 3. Grafica serie en logaritmo (Azul)
plt.plot(df_hipotecas.index, df_hipotecas['log_hipotecas'], color='blue', linewidth=2, linestyle='--', label='Log Tasa')
plt.ylabel('Escala Logarítmica', color='blue')

# Titulos
plt.title('Comparativa: Tasa Hipotecaria Original vs Transformación Logarítmica', fontsize=14, fontweight='bold')
plt.xlabel('Tiempo (Años)')

plt.show()
#se comportan bastante igual por ello no creo que sea necesario aplicar logaritmo

#%% Aplico diferencia para intentar que tenga media constante
# Se añade la columna de diferencia a la base de datos
df_hipotecas['Dif_hipotecas'] = df_hipotecas['Tasa_hipotecaria'].diff()

plt.figure(figsize=(12, 6))
plt.plot(df_hipotecas.index, df_hipotecas['Dif_hipotecas'], color='purple', linewidth=1.5)
plt.title('Primera Diferencia de la Tasa Hipotecaria ($\Delta y_t$)', fontsize=14, fontweight='bold')
plt.xlabel('Tiempo (Años)')
plt.ylabel('$\Delta y_t$')
plt.axhline(0, color='black', linestyle='-', alpha=0.5, linewidth=1) # Línea de referencia en cero
plt.grid(True, linestyle='--')
plt.show()
# mejora :D entonces creo que por el momento es un ARIMA(?,1,?)
#recapitulando no es necesario aplicar logarimo pero si aplicar diferencia

#%% Grafica FAC
# Toca quitar el primer dato por la diferencia 
serie_diferenciada = df_hipotecas['Dif_hipotecas'].dropna()

plt.figure(figsize=(16, 5))

#Grafico FAC
plt.subplot(1, 2, 1)
plot_acf(serie_diferenciada, lags=40, zero=False, ax=plt.gca(), color='darkblue')
plt.title('Función de Autocorrelación (FAC)', fontsize=13, fontweight='bold')
plt.xlabel('Rezagos (Lags)')
plt.ylabel('Autocorrelación')
plt.grid(True, linestyle='--', alpha=0.5)

#Grafico FACP
plt.subplot(1, 2, 2)
plot_pacf(serie_diferenciada, lags=40, zero=False, ax=plt.gca(), color='darkgreen')
plt.title('Función de Autocorrelación Parcial (FACP)', fontsize=13, fontweight='bold')
plt.xlabel('Rezagos (Lags)')
plt.ylabel('Autocorrelación Parcial')
plt.grid(True, linestyle='--', alpha=0.5)

plt.tight_layout()
plt.show()

# yo diria que puede ser un ARIMA(2,1,2) por parcimonia ya que tanto 
# la parte autoregresiva como la de media movil parecieran que tiene solucion imaginaria 

#%% ARIMA(2,1,2)
modelo_arima_212 = ARIMA(df_hipotecas['Tasa_hipotecaria'], order=(2, 1, 2))
resultados_212 = modelo_arima_212.fit()
print(resultados_212.summary())

#%% Predicciones con ARIMA(3,1,3)
modelo_arima_313 = ARIMA(df_hipotecas['Tasa_hipotecaria'], order=(3, 1, 3))
resultados_313 = modelo_arima_313.fit()
print(resultados_313.summary())

# %% Busuqueda automatica del mejor modelo ARIMA :D con el AIC
print("Buscando el mejor modelo ARIMA segun el criterio de AIC...")

# Ejecutamos el auto_arima 
modelo_automatico = pm.auto_arima(df_hipotecas['Tasa_hipotecaria'],
                                  start_p=0, start_q=0, # Desde qué rezagos empezar a buscar
                                  max_p=5, max_q=5,     # Hasta qué rezago máximo probar
                                  d=1,                  # Ya comprobamos que necesita 1 diferencia
                                  seasonal=False,       # No es un modelo estacional 
                                  trace=True,           # Clave: Muestra la "competencia" en la consola
                                  error_action='ignore',
                                  suppress_warnings=True,
                                  stepwise=True)        # Algoritmo eficiente de búsqueda

print("\n--- RESUMEN DEL MODELO GANADOR ---")
print(modelo_automatico.summary())
# SOy muy bueno le atine a la primera :D ARIMA(2,1,2) es el mejor modelo segun el criterio de AIC :D
# traiganme ya el otro parcial :) y lo cinqueo jaja


#%% Busuqueda automatica del mejor modelo ARIMA :D con el BIC
print("Buscando el mejor modelo ARIMA basándose en el BIC...")

# Ejecutamos el auto_arima cambiando el criterio de selección al BIC
modelo_automatico = pm.auto_arima(df_hipotecas['Tasa_hipotecaria'],
                                  start_p=0, start_q=0, 
                                  max_p=5, max_q=5,     
                                  d=1,                  
                                  seasonal=False,       
                                  information_criterion='bic', # <-- CLAVE: Fuerza a elegir por BIC
                                  trace=True,           
                                  error_action='ignore',
                                  suppress_warnings=True,
                                  stepwise=True)        

print("\n--- RESUMEN DEL MODELO GANADOR (SEGÚN BIC) ---")
print(modelo_automatico.summary())

#%% test de raiz unitaria
# Aplicamos el test a la serie diferenciada (eliminando los valores nulos)
serie_test = df_hipotecas['Dif_hipotecas'].dropna() 
resultado_adf = adfuller(serie_test)

# resultados del test
print(f'Estadístico ADF: {resultado_adf[0]:.4f}')
print(f'p-valor: {resultado_adf[1]:.4f}')
print('Valores Críticos:')
for clave, valor in resultado_adf[4].items():
    print(f'   {clave}: {valor:.4f}')

# conclusion automatica 
if resultado_adf[1] < 0.05:
    print("Se rechaza H0; la serie es estacionaria.")
else:
    print("No se rechaza H0; la serie no es estacionaria.")

# %% FAC de residuos y residuos al cuadrado
# se sacan los residuos del modelo :D
residuos = resultados_212.resid
residuos_cuadrado = residuos ** 2

# para que entren los dos graficos en la misma figura
plt.figure(figsize=(16, 5))

# FAC de los residuos
plt.subplot(1, 2, 1)
plot_acf(residuos, lags=40, zero=False, ax=plt.gca(), color='darkblue')
plt.title('FAC de los Residuos ($e_t$)', fontsize=13, fontweight='bold')
plt.xlabel('Rezagos (Lags)')
plt.ylabel('Autocorrelación')
plt.grid(True, linestyle='--', alpha=0.5)

# fac de los reiduos aal cuadrado
plt.subplot(1, 2, 2)
plot_acf(residuos_cuadrado, lags=40, zero=False, ax=plt.gca(), color='darkred')
plt.title('FAC de los Residuos al Cuadrado ($e_t^2$)', fontsize=13, fontweight='bold')
plt.xlabel('Rezagos (Lags)')
plt.ylabel('Autocorrelación')
plt.grid(True, linestyle='--', alpha=0.5)
plt.tight_layout()
plt.show()
# %% Prueba Ljung-Box

ljung_box = acorr_ljungbox(
    residuos,
    lags=[6, 12, 18, 24],
    return_df=True
)

print("Prueba Ljung-Box")
print(ljung_box)

if (ljung_box['lb_pvalue'] > 0.05).all():
    print("No se rechaza H0; no hay autocorrelación en los residuos.")
else:    
    print("Se rechaza H0; hay autocorrelación en los residuos.")
# H0: no hay autocorrelación en los residuos.
# Si p-value > 0.05, no se rechaza H0.


# %% Prueba ARCH de heterocedasticidad

arch_test = het_arch(residuos, nlags=12)

print("Prueba ARCH")
print("LM statistic:", arch_test[0])
print("LM p-value:", arch_test[1])

if arch_test[1] > 0.05:
    print("No se rechaza H0; no hay efectos ARCH.")
else:    
    print("Se rechaza H0; hay efectos ARCH.")

# H0: no hay efectos ARCH.
# Si p-value > 0.05, no se rechaza H0.


# %% Prueba de normalidad Jarque-Bera

jb_stat, jb_pvalue, asimetria, curtosis = jarque_bera(residuos)

print("Prueba Jarque-Bera")
print("Jarque-Bera statistic:", jb_stat)
print("Jarque-Bera p-value:", jb_pvalue)

if jb_pvalue > 0.05:
    print("No se rechaza H0; los residuos siguen una distribución normal.")
else:    
    print("Se rechaza H0; los residuos no siguen una distribución normal.")
# H0: los residuos siguen una distribución normal.
# Si p-value > 0.05, no se rechaza H0.

# %% Q-Q plot de los residuos
plt.figure(figsize=(6, 6))
stats.probplot(residuos, dist="norm", plot=plt)
plt.title("Q-Q plot de los residuos")
plt.grid(True)
plt.show()

# %% Gráfica de los Residuos a lo largo del tiempo

# errores del modelo
residuos = resultados_212.resid

plt.figure(figsize=(12, 5))

# grafica de los residuos
plt.plot(df_hipotecas.index, residuos, color='darkwhite' if False else 'dimgray', linewidth=1, label='Residuos ($e_t$)')

# linea de referencia en cero
plt.axhline(0, color='red', linestyle='--', alpha=0.7, linewidth=1.5, label='Media Teórica = 0')

# Configuración estética para el póster
plt.title('Comportamiento de los Residuos del Modelo ARIMA(2,1,2) en el Tiempo', fontsize=14, fontweight='bold')
plt.xlabel('Tiempo (Años)')
plt.ylabel('Valor del Error')
plt.grid(True, linestyle='--', alpha=0.5)
plt.legend(loc='upper left')

plt.tight_layout()
plt.show()

#%% pronostico 
df_hipotecas = df_hipotecas.asfreq(df_hipotecas.index.inferred_freq)

# configurar del pronostico
modelo_final = SARIMAX(
    df_hipotecas['Tasa_hipotecaria'],
    order=(2, 1, 2),
    trend='c',
    enforce_stationarity=False,
    enforce_invertibility=False
)
resultado_final = modelo_final.fit(disp=False)

# pronosticar 10 periodos 
pasos_futuros = 10
pronostico_objeto = resultado_final.get_forecast(steps=pasos_futuros)

# extraer la media y los intervalos
pronostico_nivel = pronostico_objeto.predicted_mean
intervalos_nivel = pronostico_objeto.conf_int()

# imprimir tabla 
tabla_pronostico = pd.DataFrame({
    "Pronóstico (%)": pronostico_nivel,
    "Límite Inferior": intervalos_nivel.iloc[:, 0],
    "Límite Superior": intervalos_nivel.iloc[:, 1]
})
print("\n--- TABLA DE PRONÓSTICOS GENERADA CON ÉXITO ---")
print(tabla_pronostico.round(4))


